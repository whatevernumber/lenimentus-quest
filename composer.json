{
    "require": {
        "leafs/leaf": "*",
        "laudis/neo4j-php-client": "^3.1",
        "vlucas/phpdotenv": "^5.6",
        "leafs/auth": "^2.4",
        "leafs/cors": "^1.2",
        "leafs/mvc": "^4.3"
    },
    "autoload": {
        "psr-4": {
            "Services\\": "Services/",
            "Classes\\": "Classes/",
            "App\\": "App/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
